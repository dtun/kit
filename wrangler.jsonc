{
	"name": "kit",
	"main": "src/infrastructure/index.ts",
	"compatibility_date": "2025-04-01",
	"compatibility_flags": ["nodejs_compat"],
	// Workers AI — free tier, no API key
	"ai": {
		"binding": "AI"
	},
	// R2 bucket for journal storage
	"r2_buckets": [
		{
			"binding": "JOURNAL",
			"bucket_name": "kit-journal"
		}
	],
	// Static assets — favicon, apple-touch-icons, og-image. Served by Cloudflare
	// before the worker fetch handler runs, so /favicon.ico etc. bypass Hono.
	"assets": {
		"directory": "./public"
	},
	// Durable Object for Kit agent
	"durable_objects": {
		"bindings": [
			{
				"name": "KIT_AGENT",
				"class_name": "KitAgent"
			}
		]
	},
	// SQLite for Durable Object state
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["KitAgent"]
		}
	],
	// FAMILY_MEMBERS — set via `wrangler secret put`, local dev uses .dev.vars
	// Twilio SMS — set via `wrangler secret put`:
	//   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER
	// iCloud calendar (CalDAV) — set via `wrangler secret put`:
	//   ICLOUD_APPLE_ID, ICLOUD_APP_PASSWORD
	//   ICLOUD_APP_PASSWORD must be an app-specific password generated at
	//   appleid.apple.com (the normal account password will not work). Without
	//   both secrets Kit uses a no-op calendar and digests have no events.
	// Email sending — routes replies back via Cloudflare Email Routing
	"send_email": [
		{
			"name": "SEND_EMAIL"
		}
	],
	// Custom domain — kitkit.dev DNS is on Cloudflare (email routing active).
	// FRESH DEPLOYER: this domain must be one YOU own and have onboarded to
	// Cloudflare. Change the pattern to your own domain, or delete this "routes"
	// block entirely to serve from the default <worker>.<subdomain>.workers.dev
	// URL. Keep this domain in sync with KIT_DOMAIN in src/config.ts.
	"routes": [{ "pattern": "kitkit.dev", "custom_domain": true }],
	// Cron triggers — 0 14 UTC = 7:00 AM Arizona/MST (no DST). Adjust the UTC
	// hour for your own timezone if you want the morning digest at local 7 AM.
	"triggers": {
		"crons": ["0 14 * * *"]
	}
}
